rules_version = '2';

// Every document lives under users/{uid}, so one rule covers the whole tree:
// a signed-in user may read and write only their own subtree, and nobody can
// touch anyone else's notes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Anything outside a user's own namespace is denied by default.
  }
}
