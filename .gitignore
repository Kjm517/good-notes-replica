# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build
/build/
/coverage/
/vercel_out/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Local secrets — never commit real keys
.env
.env.*
!.env.example
!.env*.example
.dart_defines.json
assets/env

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.dart_defines.web.json

# Vercel CLI project link (org/project IDs, local only)
.vercel
.env*

# Worker deps — regenerated with `npm install`, platform-specific binaries
# (this is what blew past GitHub's 100MB file limit)
worker/node_modules/

# Android release signing — never commit
android/key.properties
*.jks
*.keystore
