# Copy to `.env` in the project root (same folder as pubspec.yaml).
# Then run:  ./scripts/sync-env.sh
# Or use VS Code launch configs (Android / iOS / Chrome) — they sync automatically.
#
# Flutter reads these at compile time via .dart_defines.json (gitignored).
# Do not commit .env — it contains secrets.

# Cloudflare Worker URL for syncing PDF/image files to R2 (optional).
NOTABLY_FILE_ENDPOINT=https://notably-files.notably.workers.dev

# Google Gemini API key for AI-powered features (optional).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase (Auth + Postgres). Project Settings → API.
# URL must be the project root only — no /rest/v1.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Google sign-in (Supabase Auth):
# 1. Authentication → Providers → Google → enable, paste Web client ID + secret
#    from Google Cloud console (OAuth 2.0 Client, type Web).
# 2. Authentication → URL Configuration → Redirect URLs, add:
#      http://localhost:5000
#      http://localhost:5000/**
#      io.supabase.notably://login-callback/
#    Chrome: use the VS Code "Notably (Chrome, fixed port)" launch config (port 5000).
