{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Notably (Chrome, fixed port)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "preLaunchTask": "sync-env",
      "args": [
        "--web-port=5000",
        "--dart-define-from-file=.dart_defines.json"
      ]
    },
    {
      "name": "Notably (Android)",
      "request": "launch",
      "type": "dart",
      "deviceId": "android",
      "preLaunchTask": "sync-env",
      "args": [
        "--dart-define-from-file=.dart_defines.json"
      ]
    },
    {
      "name": "Notably (iOS)",
      "request": "launch",
      "type": "dart",
      "deviceId": "Notably iPhone",
      "preLaunchTask": "sync-env",
      "args": [
        "--dart-define-from-file=.dart_defines.json"
      ]
    }
  ]
}
